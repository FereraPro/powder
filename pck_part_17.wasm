}␀␀␀␀␀␀␀␀␀␀␀␀{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "powder-instagram": {
      "type": "stdio",
      "command": "py",
      "args": ["-3", "-B", "${PLUGIN_ROOT}/launch.py"],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "POWDER_PROJECT_ROOT": "C:/Users/ASUS/snowboard-game",
        "PYTHONUTF8": "1"
      }
    }
  }
}
␀␀␀␀␀␀␀␀␀{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "powder-instagram",
  "version": "0.1.1",
  "description": "Prepare and inspect local POWDER gameplay Reel drafts. Instagram publishing and external AI video are not connected.",
  "keywords": ["powder", "instagram", "reels", "gameplay", "local-drafts"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "POWDER Instagram",
        "shortDescription": "Local gameplay Reel drafts",
        "longDescription": "Queue gameplay drafts from the local POWDER game, inspect videos and request states, and check worker health. Local Windows tools only; no Instagram login, publishing, analytics, or paid AI generation is implemented.",
        "category": "Creativity",
        "capabilities": ["Read", "Write"],
        "defaultPrompt": ["Check my POWDER video drafts", "Create a 15-second POWDER gameplay Reel draft"]
      }
    }
  }
}
